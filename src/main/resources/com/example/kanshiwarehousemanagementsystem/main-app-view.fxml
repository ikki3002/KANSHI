                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🗄️ High-Bay Rack Storage Matrix (Level 2E)" style="-fx-font-size: 17px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                            <Label text="FACTORY I/O ASRS (54 BAYS)" style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-background-radius: 999px; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            <Label fx:id="lblAsrsStatusBadge" text="SOFT-PLC: IDLE" style="-fx-background-color: #f3f4f6; -fx-text-fill: #4b5563; -fx-background-radius: 999px; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                        </HBox>
