                        </VBox>

                        <Button text="+ Add Tag to Profile" onAction="#handleAddTag" maxWidth="Infinity"
                                style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 18; -fx-cursor: hand;">
