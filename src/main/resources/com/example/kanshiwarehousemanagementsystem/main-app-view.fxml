                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 4 6;">
                        <Label fx:id="lblFinanceRowCount" text="Showing 0 invoices" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;" />
