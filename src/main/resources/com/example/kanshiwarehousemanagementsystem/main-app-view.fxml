                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Region style="-fx-min-width: 14px; -fx-min-height: 14px; -fx-background-color: #14532d; -fx-border-radius: 3px; -fx-background-radius: 3px;" />
                                <Label text="Occupied (Stored SKU)" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Region style="-fx-min-width: 14px; -fx-min-height: 14px; -fx-background-color: #f59e0b; -fx-border-radius: 3px; -fx-background-radius: 3px;" />
                                <Label text="Crane Active Target" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;" />
                            </HBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblCraneTelemetryInfo" text="Crane Target Position: 0 (Home) | Soft-PLC: IDLE" style="-fx-font-size: 11px; -fx-font-family: 'Consolas', monospace; -fx-font-weight: bold; -fx-text-fill: #14532d; -fx-background-color: #f0fdf4; -fx-padding: 4 10; -fx-background-radius: 6px;" />
                        </HBox>

                        <!-- The Dynamic 9x6 Grid of Bay Tiles -->
                        <GridPane fx:id="gridStorageMatrix" hgap="10" vgap="10" alignment="CENTER" style="-fx-padding: 10px;" />

                        <!-- Bottom Station Info Bar -->
                        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 8 4 8; -fx-border-color: #f3f4f6 transparent transparent transparent; -fx-border-width: 1px;">
                            <Label text="Station 55: Infeed / Outfeed Transfer Point" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #065f46;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Click any bay cell to retrieve pallet or inspect stock" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>

</BorderPane>

