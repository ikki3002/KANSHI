<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.GridPane?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kanshiwarehousemanagementsystem.controller.MainAppController"
            style="-fx-background-color: #f3f4f6; -fx-font-family: 'Segoe UI', -apple-system, sans-serif;"
            prefWidth="1380" prefHeight="880">

    <!-- Top Navigation & Header Bar (Donezo Style) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #f3f4f6; -fx-padding: 16px 28px 12px 28px;">
            <!-- Sidebar Toggle Button -->
            <Button fx:id="btnToggleSidebar" text="☰" onAction="#handleToggleSidebar"
                    style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 7 14; -fx-cursor: hand;" />

            <!-- Pill Search Bar (Matching Donezo Header) -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 5 16; -fx-pref-width: 320px;">
                <Label text="🔍" style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;" />
                <TextField promptText="Search tasks, stock, tags..." HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-prompt-text-fill: #9ca3af; -fx-font-size: 12px; -fx-text-fill: #111827; -fx-padding: 2 0;" />
                <Label text="⌘ F" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6px; -fx-padding: 2 6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Live PLC Heartbeat Indicator Pill -->
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 6 14;">
                <Circle fx:id="circleHeartbeat" radius="4" fill="#ef4444" stroke="#b91c1c" strokeWidth="1" />
                <Label fx:id="lblHeartbeatStatus" text="● OFFLINE: 502" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4b5563;" />
            </HBox>

            <!-- Quick Action Icons (Mail & Notifications) -->
            <HBox alignment="CENTER" spacing="8">
                <Button text="✉" style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 6 11; -fx-cursor: hand; -fx-font-size: 13px;" />
                <Button text="🔔" style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 6 11; -fx-cursor: hand; -fx-font-size: 13px;" />
            </HBox>

            <!-- Operator Session & Profile Pill -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 4 14 4 6;">
                <Label text="👨‍💼" style="-fx-background-color: #fed7aa; -fx-background-radius: 999px; -fx-padding: 5 8; -fx-font-size: 13px;" />
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="Totok Michael" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <Label fx:id="lblOperatorEmail" text="tmichael20@mail.com" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                </VBox>
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-background-radius: 999px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Rail (Donezo Style) -->
    <left>
        <VBox fx:id="navRail" spacing="6"
              style="-fx-background-color: #f9fafb; -fx-border-color: transparent #e5e7eb transparent transparent; -fx-border-width: 1px; -fx-padding: 20px 14px; -fx-pref-width: 240px;">
            <!-- Brand Logo (Matching Donezo logo) -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 16 6;">
                <Label text="🌀" style="-fx-font-size: 24px;" />
                <Label text="Donezo" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #111827;" />
            </HBox>

            <Label fx:id="lblNavCatCore" text="MENU" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-padding: 8 0 4 8;" />
            <Button fx:id="btnNavDashboard" text="📊 Dashboard" onAction="#handleNavDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #f0fdf4; -fx-text-fill: #166534; -fx-background-radius: 10px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button fx:id="btnNavScada" text="🏭 SCADA Station" onAction="#handleNavScada" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button fx:id="btnNavInventory" text="📦 Inventory Ledger" onAction="#handleNavInventory" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button fx:id="btnNavFinance" text="💰 Finance &amp; Invoicing" onAction="#handleNavFinance" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />

            <Label fx:id="lblNavCatSystem" text="GENERAL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-padding: 14 0 4 8;" />
            <Button fx:id="btnNavTags" text="⚙️ Settings / Tags" onAction="#handleNavTags" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom Promo Card (Matching "Download our Mobile App" in the image!) -->
            <VBox fx:id="navRailFooter" spacing="8"
                  style="-fx-background-color: #064e3b; -fx-background-radius: 16px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="⚙️" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 999px; -fx-padding: 5 8; -fx-font-size: 12px; -fx-text-fill: #ffffff;" />
                    <VBox spacing="1">
                        <Label text="SCADA Gateway" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                        <Label text="Modbus TCP : 502" style="-fx-font-size: 10px; -fx-text-fill: #a7f3d0;" />
                    </VBox>
                </HBox>
                <Label text="Factory I/O industrial controller link ready." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #d1fae5;" />
                <Button text="Connect Line →" onAction="#handleNavScada" maxWidth="Infinity"
                        style="-fx-background-color: #10b981; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Workspace Host (Switches dynamically between views) -->
    <center>
        <StackPane fx:id="mainContentPane" style="-fx-background-color: transparent;">

            <!-- ============================================================= -->
            <!-- VIEW 1: LEVEL 1 EXECUTIVE COMMAND OVERVIEW DASHBOARD          -->
            <!-- ============================================================= -->
            <ScrollPane fx:id="paneDashboard" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 10px 28px 28px 28px;">

                    <!-- Welcome & Header Action Strip (Matching Donezo Header) -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Dashboard" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                            <Label text="Plan, prioritize, and accomplish your tasks with ease." style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                        </VBox>
                        <HBox alignment="CENTER" spacing="12">
                            <Button text="+ Add Project" onAction="#handleOpenCreateInvoice"
                                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 20; -fx-cursor: hand;" />
                            <Button text="Import Data" onAction="#handleExportInventoryJson"
                                    style="-fx-background-color: #ffffff; -fx-border-color: #111827; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 8 18; -fx-cursor: hand;" />
                        </HBox>
                    </HBox>

                    <!-- Top 4 KPI Metrics Row (Matching Donezo Top Cards) -->
                    <HBox spacing="16">
                        <!-- KPI Card 1: Featured Deep Emerald Green Card ("Total Projects 24") -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #14532d; -fx-background-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px; -fx-effect: dropshadow(three-pass-box, rgba(20,83,45,0.2), 12, 0, 0, 4);">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Total Projects" style="-fx-text-fill: #dcfce7; -fx-font-size: 13px; -fx-font-weight: 600;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavFinance"
                                        style="-fx-background-color: #ffffff; -fx-background-radius: 999px; -fx-text-fill: #14532d; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <Label fx:id="lblKpiValuation" text="24" style="-fx-font-size: 34px; -fx-font-weight: 800; -fx-text-fill: #ffffff;" />
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="▲ Increased from last month"
                                       style="-fx-background-color: #166534; -fx-background-radius: 6px; -fx-text-fill: #bbf7d0; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>
                        </VBox>

                        <!-- KPI Card 2: Ended Projects ("Ended Projects 10") -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Ended Projects" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavInventory"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-background-radius: 999px; -fx-border-radius: 999px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <Label fx:id="lblKpiInventory" text="10" style="-fx-font-size: 34px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label fx:id="lblKpiLowStockBadge" text="▲ Increased from last month"
                                       style="-fx-background-color: #f0fdf4; -fx-background-radius: 6px; -fx-text-fill: #166534; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>
                        </VBox>

                        <!-- KPI Card 3: Running Projects ("Running Projects 12") -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Running Projects" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavScada"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-background-radius: 999px; -fx-border-radius: 999px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Circle fx:id="circleKpiLineDot" radius="5" fill="#22c55e" />
                                <Label fx:id="lblKpiActiveEqCount" text="12" style="-fx-font-size: 34px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                                <Label fx:id="lblKpiLineState" text="RUNNING" visible="false" managed="false" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="▲ Increased from last month"
                                       style="-fx-background-color: #f0fdf4; -fx-background-radius: 6px; -fx-text-fill: #166534; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>
                        </VBox>

                        <!-- KPI Card 4: Pending Project ("Pending Project 2") -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Pending Project" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavFinance"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-background-radius: 999px; -fx-border-radius: 999px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <Label fx:id="lblKpiPackageCount" text="2" style="-fx-font-size: 34px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                            <Label text="On Discuss" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px; -fx-font-weight: 500;" />
                            <Label fx:id="lblKpiSkuCount" text="5 SKUs" visible="false" managed="false" />
                        </VBox>
                    </HBox>

                    <!-- Middle Row: 3 Cards (Project Analytics | Reminders | Project) -->
                    <HBox spacing="16">
                        <!-- Card 1: Project Analytics (Pill Bar Chart) -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS" prefWidth="380"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 22px;">
                            <Label text="Project Analytics" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;" />

                            <!-- 7 Vertical Pill Bars (S, M, T, W, T, F, S) -->
                            <HBox alignment="BOTTOM_CENTER" spacing="14" style="-fx-padding: 10 0 4 0;" prefHeight="130">
                                <!-- Sunday -->
                                <VBox alignment="BOTTOM_CENTER" spacing="8">
                                    <Region prefWidth="30" prefHeight="70" style="-fx-background-color: #e5e7eb; -fx-background-radius: 999px;" />
                                    <Label text="S" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                                </VBox>
                                <!-- Monday -->
                                <VBox alignment="BOTTOM_CENTER" spacing="8">
                                    <Region prefWidth="30" prefHeight="95" style="-fx-background-color: #e5e7eb; -fx-background-radius: 999px;" />
                                    <Label text="M" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                                </VBox>
                                <!-- Tuesday (74% Mint Bar) -->
                                <VBox alignment="BOTTOM_CENTER" spacing="6">
                                    <Label text="74%" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #15803d; -fx-background-color: #dcfce7; -fx-padding: 1 4; -fx-background-radius: 4px;" />
                                    <Region prefWidth="32" prefHeight="100" style="-fx-background-color: #4ade80; -fx-background-radius: 999px;" />
                                    <Label text="T" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                                </VBox>
                                <!-- Wednesday (Solid Dark Green Peak Bar) -->
                                <VBox alignment="BOTTOM_CENTER" spacing="8">
                                    <Region prefWidth="32" prefHeight="120" style="-fx-background-color: #14532d; -fx-background-radius: 999px;" />
                                    <Label text="W" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                </VBox>
                                <!-- Thursday -->
                                <VBox alignment="BOTTOM_CENTER" spacing="8">
                                    <Region prefWidth="30" prefHeight="85" style="-fx-background-color: #e5e7eb; -fx-background-radius: 999px;" />
                                    <Label text="T" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                                </VBox>
                                <!-- Friday -->
                                <VBox alignment="BOTTOM_CENTER" spacing="8">
                                    <Region prefWidth="30" prefHeight="90" style="-fx-background-color: #e5e7eb; -fx-background-radius: 999px;" />
                                    <Label text="F" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                                </VBox>
                                <!-- Saturday -->
                                <VBox alignment="BOTTOM_CENTER" spacing="8">
                                    <Region prefWidth="30" prefHeight="65" style="-fx-background-color: #e5e7eb; -fx-background-radius: 999px;" />
                                    <Label text="S" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Card 2: Reminders ("Meeting with Arc Company") -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS" prefWidth="340"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 22px;">
                            <Label text="Reminders" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                            <VBox spacing="3" VBox.vgrow="ALWAYS">
                                <Label text="Meeting with Arc Company" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                                <Label text="Time : 02.00 pm - 04.00 pm" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                            </VBox>
                            <Button text="📹 Start Meeting" onAction="#handleNavScada" maxWidth="Infinity"
                                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-cursor: hand;" />
                        </VBox>

                        <!-- Card 3: Project (List with Colored Icons) -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="340"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 22px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Project" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="+ New" onAction="#handleNavTags"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 12; -fx-cursor: hand;" />
                            </HBox>

                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="⚡" style="-fx-text-fill: #3b82f6; -fx-font-size: 14px;" />
                                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                                        <Label text="Develop API Endpoints" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #111827;" />
                                        <Label text="Due date: Nov 26, 2024" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="🔄" style="-fx-text-fill: #10b981; -fx-font-size: 14px;" />
                                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                                        <Label text="Onboarding Flow" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #111827;" />
                                        <Label text="Due date: Nov 28, 2024" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="📦" style="-fx-text-fill: #f59e0b; -fx-font-size: 14px;" />
                                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                                        <Label text="Build Dashboard" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #111827;" />
                                        <Label text="Due date: Nov 30, 2024" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="👁️" style="-fx-text-fill: #ef4444; -fx-font-size: 14px;" />
