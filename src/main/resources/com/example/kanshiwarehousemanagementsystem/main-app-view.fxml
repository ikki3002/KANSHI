            <VBox fx:id="paneTags" visible="false" managed="false" spacing="20" style="-fx-padding: 20px 28px;">
                <VBox spacing="4"
                      style="-fx-background-color: #ffffff; -fx-padding: 18px 22px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
                    <Label text="Hardware Tag Profiler &amp; JSON Configuration (Level 2D)" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                    <Label text="Dynamically configure Modbus PLC coils and discrete inputs stored in warehouse_tags.json without code recompilation." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                </VBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <!-- Table Card -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff; -fx-padding: 18px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
                        <TableView fx:id="tableTags" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colTagName" text="Tag Name" prefWidth="240" />
