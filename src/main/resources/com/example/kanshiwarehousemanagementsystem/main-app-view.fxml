                    <Button fx:id="btnOpenUnloadModal" text="📤 Unload / Dispatch Product" onAction="#handleOpenUnloadDialog"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;" />
                    <Button fx:id="btnDispatchInfeed" text="📦 Ingest Pallet at Infeed" onAction="#handleTriggerInfeedStore"
                            style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;" />
                    <Button text="↺ Refresh" onAction="#handleRefreshMatrix"
                            style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 12; -fx-cursor: hand;" />
                </HBox>

                <!-- 9x6 High-Bay Rack Grid Container -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox spacing="14" style="-fx-background-color: #ffffff; -fx-padding: 22px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
