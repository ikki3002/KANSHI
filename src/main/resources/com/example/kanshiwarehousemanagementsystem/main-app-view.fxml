<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kanshiwarehousemanagementsystem.controller.MainAppController"
            styleClass="main-container"
            prefWidth="1200" prefHeight="780">

    <!-- Top Navigation & Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="station-header-bar">
            <!-- Brand -->
            <VBox spacing="2">
                <Label text="KANSHI WMS" styleClass="portal-brand" style="-fx-font-size: 22px;" />
                <Label text="Convergence IT/OT Control Platform" styleClass="station-subtitle" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Real-Time Live Clock -->
            <Label fx:id="lblClock" text="--:--:--  |  --- -- ----" styleClass="header-clock-badge" />

            <!-- Live PLC Heartbeat Indicator -->
            <HBox alignment="CENTER" spacing="8" styleClass="plc-heartbeat-pill">
                <Circle fx:id="circleHeartbeat" radius="5" fill="#ef4444" stroke="#b91c1c" strokeWidth="1" />
                <Label fx:id="lblHeartbeatStatus" text="● OFFLINE: 502" styleClass="field-label" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Operator Session & Logout -->
            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="lblOperatorEmail" text="👤 Operator: admin@gmail.com" styleClass="field-label" />
                <Button text="Logout" onAction="#handleLogout" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 14;" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Rail (3-Level Architecture Navigation) -->
    <left>
        <VBox styleClass="nav-rail">
            <Label text="CORE COMMAND" styleClass="nav-category-header" />
            <Button fx:id="btnNavDashboard" text="📊 Overview Dashboard" onAction="#handleNavDashboard" styleClass="nav-item-btn, active" />

            <Label text="WORKSPACES" styleClass="nav-category-header">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
            </Label>
            <Button fx:id="btnNavScada" text="🏭 OT SCADA Station" onAction="#handleNavScada" styleClass="nav-item-btn" />
            <Button fx:id="btnNavInventory" text="📦 Inventory Ledger" onAction="#handleNavInventory" styleClass="nav-item-btn" />
            <Button fx:id="btnNavFinance" text="💰 Finance &amp; Invoicing" onAction="#handleNavFinance" styleClass="nav-item-btn" />

            <Label text="SYSTEM &amp; CONFIG" styleClass="nav-category-header">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
            </Label>
            <Button fx:id="btnNavTags" text="⚙️ Hardware Tag Profiler" onAction="#handleNavTags" styleClass="nav-item-btn" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- System Info Footer -->
            <VBox spacing="4" style="-fx-padding: 10px; -fx-background-color: #f8fafc; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                <Label text="KANSHI WMS v1.0" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7a0c1e;" />
                <Label text="Modbus TCP / Factory I/O" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                <Label text="SQLite kanshi.db Connected" style="-fx-font-size: 10px; -fx-text-fill: #15803d; -fx-font-weight: 600;" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Workspace Host (Switches dynamically between views) -->
    <center>
        <StackPane fx:id="mainContentPane" styleClass="content-pane">

            <!-- ============================================================= -->
            <!-- VIEW 1: LEVEL 1 EXECUTIVE COMMAND OVERVIEW DASHBOARD          -->
            <!-- ============================================================= -->
            <ScrollPane fx:id="paneDashboard" fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 24px;">

                    <!-- Welcome Banner -->
                    <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 20px 24px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <Label text="Executive Command Center (Level 1)" styleClass="station-title" style="-fx-font-size: 18px;" />
                        <Label text="Real-time operational summary uniting IT warehouse inventory and Factory I/O SCADA hardware automation." styleClass="station-subtitle" />
                    </VBox>

                    <!-- Top KPI Metrics Grid (Module 2 Roadmap) -->
                    <HBox spacing="16">
                        <!-- KPI 1: Warehouse Valuation -->
                        <VBox spacing="6" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <Label text="WAREHOUSE VALUATION" styleClass="field-label" style="-fx-font-size: 11px;" />
                            <Label fx:id="lblKpiValuation" text="-- EUR" styleClass="portal-brand" style="-fx-font-size: 24px;" />
                            <Label text="Asset value calculated from SQLite" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <!-- KPI 2: Total Inventory -->
                        <VBox spacing="6" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL INVENTORY STOCK" styleClass="field-label" style="-fx-font-size: 11px;" />
                            <Label fx:id="lblKpiInventory" text="-- Units" styleClass="portal-brand" style="-fx-font-size: 24px;" />
                            <Label text="Stored inventory ledger items" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <!-- KPI 3: Line Telemetry -->
                        <VBox spacing="6" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <Label text="CONVEYOR LINE STATUS" styleClass="field-label" style="-fx-font-size: 11px;" />
                            <Label fx:id="lblKpiLineState" text="IDLE" styleClass="portal-brand" style="-fx-font-size: 24px; -fx-text-fill: #64748b;" />
                            <Label text="Factory I/O line actuator state" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <!-- KPI 4: Packages Processed -->
                        <VBox spacing="6" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <Label text="PACKAGES DETECTED" styleClass="field-label" style="-fx-font-size: 11px;" />
                            <Label fx:id="lblKpiPackageCount" text="0 Pcs" styleClass="portal-brand" style="-fx-font-size: 24px; -fx-text-fill: #15803d;" />
                            <Label text="Vision Sensor 0 count today" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>
                    </HBox>

                    <!-- Module Quick-Navigation Gateways -->
                    <Label text="Operational Workspaces (Level 2 Quick Access)" styleClass="station-title" style="-fx-font-size: 15px;" />
                    <HBox spacing="16">
                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavScada">
                            <Label text="🏭 OT SCADA Line Control" styleClass="station-title" style="-fx-font-size: 16px;" />
                            <Label text="Access live conveyor actuation, optical sensors, 2s test sequence, and emergency stop." wrapText="true" styleClass="station-subtitle" />
                            <Button text="Launch SCADA Station →" onAction="#handleNavScada" styleClass="btn-primary" style="-fx-font-size: 12px; -fx-padding: 6 12;" />
                        </VBox>

                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavInventory">
                            <Label text="📦 Inventory Stock Ledger" styleClass="station-title" style="-fx-font-size: 16px;" />
                            <Label text="Manage SQLite product catalog, SKU tracking, bin locations, and stock levels." wrapText="true" styleClass="station-subtitle" />
                            <Button text="Open Inventory Ledger →" onAction="#handleNavInventory" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 12;" />
                        </VBox>

                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavFinance">
                            <Label text="💰 Financial Valuation" styleClass="station-title" style="-fx-font-size: 16px;" />
                            <Label text="Stock valuation calculators, billing invoices, and financial reporting exports." wrapText="true" styleClass="station-subtitle" />
                            <Button text="View Finances →" onAction="#handleNavFinance" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 12;" />
                        </VBox>
                    </HBox>

                    <!-- Converged Real-Time Activity Log (IT & OT Events Stream) -->
                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="2">
                                <Label text="Converged Operational Activity Log (IT &amp; OT Stream)" styleClass="station-title" style="-fx-font-size: 15px;" />
                                <Label text="Live unified audit trail combining user actions, SQLite database updates, and Factory I/O PLC events." styleClass="station-subtitle" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="↺ Refresh Metrics" onAction="#handleRefreshDashboard" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;" />
                            <Button text="Clear Log" onAction="#handleClearAuditStream" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;" />
                        </HBox>
                        <TextArea fx:id="txtAuditStream" prefRowCount="6" editable="false" styleClass="telemetry-log" />
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ============================================================= -->
            <!-- VIEW 2: LEVEL 2A OT SCADA HARDWARE CONTROL STATION            -->
            <!-- ============================================================= -->
            <VBox fx:id="paneScada" visible="false" managed="false">
                <!-- Hardware Toolbar & Quick Emergency Controls -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="connection-toolbar">
                    <Label text="Host IP:" styleClass="field-label" />
                    <TextField fx:id="txtHost" text="127.0.0.1" prefWidth="125" styleClass="industrial-input" />

                    <Label text="Port:" styleClass="field-label" />
                    <TextField fx:id="txtPort" text="502" prefWidth="65" styleClass="industrial-input" />

                    <Button fx:id="btnConnect" text="Connect" onAction="#handleToggleConnect" styleClass="btn-primary" />

                    <HBox alignment="CENTER" spacing="6">
                        <Circle fx:id="circleStatus" radius="6" fill="#ef4444" stroke="#b91c1c" strokeWidth="1" />
                        <Label fx:id="lblConnectionStatus" text="DISCONNECTED" styleClass="field-label" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnAutoTest" text="⚡ 2s Test Sequence" onAction="#handleRunAutoSequence" styleClass="btn-secondary" />
                    <Button fx:id="btnEstop" text="🛑 EMERGENCY STOP" onAction="#handleEmergencyStop" styleClass="btn-estop" />
                </HBox>

                <!-- SCADA Content (Actuators, Sensors, Log) -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <VBox spacing="20" style="-fx-padding: 24px;">

                        <!-- Actuators Panel -->
                        <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="⚙ Output Actuators (Coils)" styleClass="station-title" style="-fx-font-size: 16px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Auto-populated from warehouse_tags.json" styleClass="station-subtitle" />
                            </HBox>
                            <FlowPane fx:id="actuatorsContainer" hgap="16" vgap="16" />
                        </VBox>

                        <!-- Sensors Panel -->
                        <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="📡 Digital Inputs (Discrete Sensors)" styleClass="station-title" style="-fx-font-size: 16px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Polling rate: 100ms background thread" styleClass="station-subtitle" />
                            </HBox>
                            <FlowPane fx:id="sensorsContainer" hgap="16" vgap="16" />
                        </VBox>

                        <!-- Telemetry Log -->
                        <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Modbus Telemetry &amp; Event Stream" styleClass="station-title" style="-fx-font-size: 14px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Clear Log" onAction="#handleClearLog" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;" />
                            </HBox>
                            <TextArea fx:id="txtLog" prefRowCount="6" editable="false" styleClass="telemetry-log" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 3: LEVEL 2B INVENTORY LEDGER (Module 4 Ready)             -->
            <!-- ============================================================= -->
            <VBox fx:id="paneInventory" visible="false" managed="false" spacing="20" style="-fx-padding: 24px;">
                <VBox spacing="6" style="-fx-background-color: #ffffff; -fx-padding: 20px 24px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="Warehouse Inventory Stock Ledger (Level 2B)" styleClass="station-title" style="-fx-font-size: 18px;" />
                    <Label text="Relational SQLite inventory table with SKU tracking, category filtering, and location bin management." styleClass="station-subtitle" />
                </VBox>
                <VBox alignment="CENTER" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 40px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                    <Label text="📦 Inventory Module (Step 4 of Roadmap)" styleClass="station-title" style="-fx-font-size: 16px; -fx-text-fill: #7a0c1e;" />
                    <Label text="Module 4 will implement the complete SQLite product inventory table with search, sorting, and barcode management." styleClass="station-subtitle" />
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 4: LEVEL 2C FINANCE & INVOICING (Module 6 Ready)          -->
            <!-- ============================================================= -->
            <VBox fx:id="paneFinance" visible="false" managed="false" spacing="20" style="-fx-padding: 24px;">
                <VBox spacing="6" style="-fx-background-color: #ffffff; -fx-padding: 20px 24px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="Financial Valuation &amp; Billing (Level 2C)" styleClass="station-title" style="-fx-font-size: 18px;" />
                    <Label text="Automated warehouse valuation calculations, customer order billing, and invoice ledger." styleClass="station-subtitle" />
                </VBox>
                <VBox alignment="CENTER" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 40px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                    <Label text="💰 Finance Module (Step 6 of Roadmap)" styleClass="station-title" style="-fx-font-size: 16px; -fx-text-fill: #7a0c1e;" />
                    <Label text="Module 6 will connect inventory prices to calculate live total valuation and generate customer invoices." styleClass="station-subtitle" />
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 5: LEVEL 2D HARDWARE TAG CONFIGURATION PROFILER          -->
            <!-- ============================================================= -->
            <VBox fx:id="paneTags" visible="false" managed="false" spacing="20" style="-fx-padding: 24px;">
                <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 16px 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="Hardware Tag Profiler &amp; JSON Configuration (Level 2D)" styleClass="station-title" style="-fx-font-size: 18px;" />
                    <Label text="Dynamically configure Modbus PLC coils and discrete inputs stored in warehouse_tags.json without code recompilation." styleClass="station-subtitle" />
                </VBox>

                <HBox spacing="24" VBox.vgrow="ALWAYS">
                    <!-- Table of Configured Tags -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <TableView fx:id="tableTags" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colTagName" text="Tag Name" prefWidth="240" />
                                <TableColumn fx:id="colTagType" text="Type" prefWidth="180" />
                                <TableColumn fx:id="colTagAddress" text="Modbus Address" prefWidth="140" />
                                <TableColumn fx:id="colTagAction" text="Action" prefWidth="100" />
                            </columns>
                        </TableView>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="💾 Save to warehouse_tags.json" onAction="#handleSaveTags" styleClass="btn-primary" />
                            <Button text="↺ Reset to Factory I/O Defaults" onAction="#handleResetTags" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                    <!-- Form to Add New Tag -->
                    <VBox spacing="14" styleClass="portal-card" style="-fx-min-width: 320px; -fx-max-width: 340px; -fx-padding: 24px;">
                        <Label text="Add Hardware Tag" styleClass="station-title" style="-fx-font-size: 16px;" />
                        <Label text="Add new conveyor or sensor without writing code." styleClass="station-subtitle" />

                        <VBox spacing="6">
                            <Label text="Tag Name:" styleClass="field-label" />
                            <TextField fx:id="txtNewTagName" promptText="e.g. Diverter Arm 1" styleClass="industrial-input" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Modbus Register Address:" styleClass="field-label" />
                            <TextField fx:id="txtNewTagAddress" promptText="e.g. 3" styleClass="industrial-input" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Tag Type:" styleClass="field-label" />
                            <ComboBox fx:id="cmbNewTagType" maxWidth="Infinity" styleClass="industrial-input" />
                        </VBox>

                        <Button text="+ Add Tag to Profile" onAction="#handleAddTag" styleClass="btn-primary" maxWidth="Infinity">
                            <VBox.margin>
                                <Insets top="8" />
                            </VBox.margin>
                        </Button>
                    </VBox>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
