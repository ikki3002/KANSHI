<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.GridPane?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kanshiwarehousemanagementsystem.controller.MainAppController"
            style="-fx-background-color: #f3f4f6; -fx-font-family: 'Segoe UI', -apple-system, sans-serif;"
            prefWidth="1380" prefHeight="880">

    <!-- Top Navigation & Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #f3f4f6; -fx-padding: 16px 28px 12px 28px;">
            <!-- Sidebar Toggle Button -->
            <Button fx:id="btnToggleSidebar" text="☰" onAction="#handleToggleSidebar"
                    style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 7 14; -fx-cursor: hand;" />

            <!-- Pill Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 5 16; -fx-pref-width: 320px;">
                <Label text="🔍" style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;" />
                <TextField promptText="Search tasks, stock, tags..." HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-prompt-text-fill: #9ca3af; -fx-font-size: 12px; -fx-text-fill: #111827; -fx-padding: 2 0;" />
                <Label text="⌘ F" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6px; -fx-padding: 2 6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Live PLC Heartbeat Indicator Pill -->
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 6 14;">
                <Circle fx:id="circleHeartbeat" radius="4" fill="#ef4444" stroke="#b91c1c" strokeWidth="1" />
                <Label fx:id="lblHeartbeatStatus" text="● OFFLINE: 502" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4b5563;" />
            </HBox>

            <!-- Quick Action Icons -->
            <HBox alignment="CENTER" spacing="8">
                <Button text="✉" style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 6 11; -fx-cursor: hand; -fx-font-size: 13px;" />
                <Button text="🔔" style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 6 11; -fx-cursor: hand; -fx-font-size: 13px;" />
            </HBox>

            <!-- Operator Session & Profile Pill -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 4 14 4 6;">
                <Label text="👨‍💼" style="-fx-background-color: #dcfce7; -fx-background-radius: 999px; -fx-padding: 5 8; -fx-font-size: 13px;" />
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="Operator" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <Label fx:id="lblOperatorEmail" text="operator@kanshi.local" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                </VBox>
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-background-radius: 999px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Rail -->
    <left>
        <VBox fx:id="navRail" spacing="6"
              style="-fx-background-color: #f9fafb; -fx-border-color: transparent #e5e7eb transparent transparent; -fx-border-width: 1px; -fx-padding: 20px 14px; -fx-pref-width: 240px;">
            <!-- Brand Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 16 6;">
                <Label text="📦" style="-fx-font-size: 24px;" />
                <VBox spacing="1">
                    <Label text="KANSHI" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #111827; -fx-letter-spacing: 0.5px;" />
                    <Label text="WMS • IT/OT Convergence" style="-fx-font-size: 10px; -fx-font-weight: 600; -fx-text-fill: #6b7280;" />
                </VBox>
            </HBox>

            <Label fx:id="lblNavCatCore" text="CORE WORKSPACES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-padding: 8 0 4 8;" />
            <Button fx:id="btnNavDashboard" text="📊 Dashboard" onAction="#handleNavDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #f0fdf4; -fx-text-fill: #166534; -fx-background-radius: 10px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />

            <Label fx:id="lblNavCatWorkspaces" text="OPERATIONS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-padding: 12 0 4 8;" />
            <Button fx:id="btnNavScada" text="🏭 SCADA Station" onAction="#handleNavScada" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button fx:id="btnNavMatrix" text="🗄️ Storage Matrix" onAction="#handleNavMatrix" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button fx:id="btnNavInventory" text="📦 Inventory Ledger" onAction="#handleNavInventory" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />
            <Button fx:id="btnNavFinance" text="💰 Finance &amp; Invoicing" onAction="#handleNavFinance" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />

            <Label fx:id="lblNavCatSystem" text="SYSTEM" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-padding: 14 0 4 8;" />
            <Button fx:id="btnNavTags" text="⚙️ Settings / Tags" onAction="#handleNavTags" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 10px; -fx-font-weight: 500; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-font-size: 13px; -fx-cursor: hand;" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom Gateway Card -->
            <VBox fx:id="navRailFooter" spacing="8"
                  style="-fx-background-color: #064e3b; -fx-background-radius: 16px; -fx-padding: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="⚙️" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 999px; -fx-padding: 5 8; -fx-font-size: 12px; -fx-text-fill: #ffffff;" />
                    <VBox spacing="1">
                        <Label text="SCADA Gateway" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                        <Label text="Modbus TCP : 502" style="-fx-font-size: 10px; -fx-text-fill: #a7f3d0;" />
                    </VBox>
                </HBox>
                <Label text="Factory I/O industrial controller link ready." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #d1fae5;" />
                <Button text="Connect Line →" onAction="#handleNavScada" maxWidth="Infinity"
                        style="-fx-background-color: #10b981; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Workspace Host -->
    <center>
        <StackPane fx:id="mainContentPane" style="-fx-background-color: transparent;">

            <!-- ============================================================= -->
            <!-- VIEW 1: LEVEL 1 EXECUTIVE COMMAND OVERVIEW DASHBOARD          -->
            <!-- ============================================================= -->
            <ScrollPane fx:id="paneDashboard" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 10px 28px 28px 28px;">

                    <!-- Welcome & Header Action Strip -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Executive Overview" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                            <Label text="Live Warehouse IT/OT Convergence &amp; Operational Telemetry" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                        </VBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Button text="+ Create Invoice" onAction="#handleOpenCreateInvoice"
                                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand;" />
                            <Button text="📦 Export JSON" onAction="#handleExportInventoryJson"
                                    style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8 16; -fx-cursor: hand;" />
                            <Button text="↺ Refresh" onAction="#handleRefreshDashboard"
                                    style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8 14; -fx-cursor: hand;" />
                        </HBox>
                    </HBox>

                    <!-- Top 4 KPI Metrics Row -->
                    <HBox spacing="16">
                        <!-- KPI Card 1: Featured Deep Emerald Green Card -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #14532d; -fx-background-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px; -fx-effect: dropshadow(three-pass-box, rgba(20,83,45,0.2), 12, 0, 0, 4);">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="TOTAL ASSET VALUATION" style="-fx-text-fill: #dcfce7; -fx-font-size: 11px; -fx-font-weight: 700; -fx-letter-spacing: 0.5px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavFinance"
                                        style="-fx-background-color: #ffffff; -fx-background-radius: 999px; -fx-text-fill: #14532d; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <Label fx:id="lblKpiValuation" text="\$0.00" style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #ffffff;" />
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label fx:id="lblKpiSkuCount" text="0 Active SKUs"
                                       style="-fx-background-color: #166534; -fx-background-radius: 6px; -fx-text-fill: #bbf7d0; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>
                        </VBox>

                        <!-- KPI Card 2: Total Inventory Stock -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="TOTAL INVENTORY STOCK" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: 700; -fx-letter-spacing: 0.5px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavInventory"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <Label fx:id="lblKpiInventory" text="0 Units" style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label fx:id="lblKpiLowStockBadge" text="Stock Normal"
                                       style="-fx-background-color: #f0fdf4; -fx-background-radius: 6px; -fx-text-fill: #166534; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>
                        </VBox>

                        <!-- KPI Card 3: Conveyor Line Status -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="CONVEYOR LINE STATUS" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: 700; -fx-letter-spacing: 0.5px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavScada"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Circle fx:id="circleKpiLineDot" radius="6" fill="#94a3b8" />
                                <Label fx:id="lblKpiLineState" text="DISCONNECTED" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #64748b;" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label fx:id="lblKpiActiveEqCount" text="0/0 Active"
                                       style="-fx-background-color: #f3f4f6; -fx-background-radius: 6px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>
                        </VBox>

                        <!-- KPI Card 4: Packages Detected -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-min-width: 220px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="PACKAGES DETECTED" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: 700; -fx-letter-spacing: 0.5px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="↗" onAction="#handleNavScada"
                                        style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-text-fill: #4b5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-cursor: hand;" />
                            </HBox>
                            <Label fx:id="lblKpiPackageCount" text="0 Pcs" style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                            <Label text="Optical entry sensor counter" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px; -fx-font-weight: 500;" />
                        </VBox>
                    </HBox>

                    <!-- Middle Row: Concurrency Buffer & Fast Line Controls -->
                    <HBox spacing="16">
                        <!-- Card 1: Thread-Safe Intake Queue (Producer-Consumer Engine) -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 22px;">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="⚡" style="-fx-font-size: 18px; -fx-text-fill: #16a34a;" />
                                <VBox spacing="2">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Thread-Safe Intake Queue" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                                        <Label text="PRODUCER-CONSUMER"
                                               style="-fx-background-color: #dcfce7; -fx-background-radius: 999px; -fx-text-fill: #15803d; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 2 8;" />
                                    </HBox>
                                    <Label text="Bounded WarehouseBuffer (ReentrantLock &amp; Conditions)" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="📦 Ingest Batch (+5)" onAction="#handleTriggerProducerBatch"
                                        style="-fx-background-color: #f0fdf4; -fx-text-fill: #166534; -fx-border-color: #bbf7d0; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-cursor: hand;" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label fx:id="lblBufferUsage" text="Queue Capacity: 0 / 10 Packages (0% Full)" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblProducerStatus" text="PRODUCER: IDLE"
                                       style="-fx-background-color: #f3f4f6; -fx-background-radius: 6px; -fx-text-fill: #4b5563; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                                <Label fx:id="lblConsumerStatus" text="CONSUMER: LISTENING"
                                       style="-fx-background-color: #dbeafe; -fx-background-radius: 6px; -fx-text-fill: #1d4ed8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                            </HBox>

                            <!-- Visual Slot Strip -->
                            <HBox fx:id="boxBufferVisualSlots" spacing="6" alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px 14px;" />
                        </VBox>

                        <!-- Card 2: OT Line Controls & Live Digital Clock -->
                        <VBox spacing="14" prefWidth="380"
                              style="-fx-background-color: #052e16; -fx-background-radius: 16px; -fx-padding: 22px; -fx-effect: dropshadow(three-pass-box, rgba(5,46,22,0.3), 16, 0, 0, 6);">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="OT Line Controls &amp; Clock" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #a7f3d0;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Modbus TCP" style="-fx-font-size: 10px; -fx-text-fill: #6ee7b7; -fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 999px; -fx-padding: 2 8;" />
                            </HBox>

                            <VBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="CURRENT SYSTEM TIME" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6ee7b7;" />
                                <Label fx:id="lblClock" text="00:00:00  |  01 Jan 2025"
                                       style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #ffffff;" />
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" />

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="btnDashStartAll" text="▶ Start All" onAction="#handleStartAllSystem" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                        style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="⚡ 2s Test" onAction="#handleRunAutoSequence" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                        style="-fx-background-color: #ffffff; -fx-text-fill: #052e16; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 16; -fx-cursor: hand;" />
                                <Button text="🛑 E-STOP" onAction="#handleEmergencyStop" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                        style="-fx-background-color: #ef4444; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 16; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Operational Workspaces Gateways (Level 2 Quick Access) -->
                    <VBox spacing="12">
                        <Label text="Operational Workspaces (Level 2 Access)" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                        <HBox spacing="16">
                            <!-- Gateway 1: SCADA -->
                            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="260" onMouseClicked="#handleNavScada"
                                  style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-padding: 20px; -fx-cursor: hand;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="🏭" style="-fx-font-size: 20px;" />
                                    <Label text="OT SCADA Station" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                                </HBox>
                                <Label text="Interactive 2D factory floor layout, live conveyor actuation, optical sensors, and emergency stop." wrapText="true"
                                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" VBox.vgrow="ALWAYS" />
