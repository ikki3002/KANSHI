                    <TableView fx:id="tableInvoices" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colInvoiceNumber" text="Invoice #" prefWidth="140" />
                            <TableColumn fx:id="colInvoiceCustomer" text="Customer Name" prefWidth="220" />
                            <TableColumn fx:id="colInvoiceUserId" text="Operator ID" prefWidth="100" />
                            <TableColumn fx:id="colInvoiceDate" text="Date &amp; Time" prefWidth="160" />
                            <TableColumn fx:id="colInvoiceStatus" text="Status" prefWidth="120" />
                            <TableColumn fx:id="colInvoiceItemsCount" text="Line Items" prefWidth="110" />
                            <TableColumn fx:id="colInvoiceTotal" text="Total Amount" prefWidth="130" />
