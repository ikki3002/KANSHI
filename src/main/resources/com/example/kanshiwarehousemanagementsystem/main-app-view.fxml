                        <Label fx:id="lblInventoryRowCount" text="Showing 0 products" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Database: SQLite (kanshi.db) • Table: inventory" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 4: LEVEL 2C FINANCE & INVOICING (Module 6)                -->
            <!-- ============================================================= -->
            <VBox fx:id="paneFinance" visible="false" managed="false" spacing="16" style="-fx-padding: 20px 28px;" VBox.vgrow="ALWAYS">
                <!-- Header Card -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: #ffffff; -fx-padding: 18px 22px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="💰 Commercial Invoicing &amp; Financial Valuation (Level 2C)" style="-fx-font-size: 17px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                            <Label text="SQLITE RELATIONAL (FK)" style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-background-radius: 999px; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3 8;" />
                        </HBox>
                        <Label text="Customer billing, automated multi-item order dispatches, sales tax, and commercial ledger." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                    </VBox>
                    <HBox alignment="CENTER" spacing="14">
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="TOTAL INVOICED REVENUE" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" />
                            <Label fx:id="lblFinanceTotalRevenue" text="\$0.00" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #15803d;" />
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="PAID ORDERS" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" />
                            <Label fx:id="lblFinancePaidCount" text="0 Paid" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="PENDING ORDERS" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" />
                            <Label fx:id="lblFinancePendingCount" text="0 Pending" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #b45309;" />
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="WAREHOUSE ASSET WORTH" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" />
                            <Label fx:id="lblFinanceCatalogValuation" text="\$0.00" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #14532d;" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Search, Filter & Action Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: #ffffff; -fx-padding: 12px 18px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
                    <Label text="🔍" style="-fx-font-size: 14px;" />
                    <TextField fx:id="txtFinanceSearch" promptText="Search by Invoice # or Customer name..." prefWidth="300"
                               style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-padding: 7 14; -fx-font-size: 12px;" />

                    <Label text="Status:" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;">
                        <HBox.margin>
                            <Insets left="8" />
                        </HBox.margin>
                    </Label>
                    <ComboBox fx:id="cmbFinanceStatusFilter" prefWidth="160"
                              style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 12px;" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button text="+ Create Invoice" onAction="#handleOpenCreateInvoice"
                            style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;" />
                    <Button text="💾 Export JSON" onAction="#handleExportInvoicesJson"
                            style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 7 14; -fx-cursor: hand;" />
                    <Button text="↺" onAction="#handleRefreshFinance"
                            style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 11; -fx-cursor: hand;" />
                </HBox>

                <!-- TableView of Invoices Card -->
                <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tableInvoices" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colInvoiceNumber" text="Invoice #" prefWidth="140" />
                            <TableColumn fx:id="colInvoiceCustomer" text="Customer Name" prefWidth="220" />
                            <TableColumn fx:id="colInvoiceUserId" text="Operator ID" prefWidth="100" />
                            <TableColumn fx:id="colInvoiceDate" text="Date &amp; Time" prefWidth="160" />
                            <TableColumn fx:id="colInvoiceStatus" text="Status" prefWidth="120" />
                            <TableColumn fx:id="colInvoiceItemsCount" text="Line Items" prefWidth="110" />
                            <TableColumn fx:id="colInvoiceTotal" text="Total Amount" prefWidth="130" />
                            <TableColumn fx:id="colInvoiceActions" text="Actions" prefWidth="170" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 4 6;">
                        <Label fx:id="lblFinanceRowCount" text="Showing 0 invoices" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Database: SQLite (kanshi.db) • Tables: invoices ➔ invoice_items (Foreign Key)" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 5: LEVEL 2D HARDWARE TAG CONFIGURATION PROFILER          -->
            <!-- ============================================================= -->
            <VBox fx:id="paneTags" visible="false" managed="false" spacing="20" style="-fx-padding: 20px 28px;">
                <VBox spacing="4"
                      style="-fx-background-color: #ffffff; -fx-padding: 18px 22px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
                    <Label text="Hardware Tag Profiler &amp; JSON Configuration (Level 2D)" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                    <Label text="Dynamically configure Modbus PLC coils and discrete inputs stored in warehouse_tags.json without code recompilation." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                </VBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <!-- Table Card -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff; -fx-padding: 18px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px;">
                        <TableView fx:id="tableTags" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colTagName" text="Tag Name" prefWidth="240" />
                                <TableColumn fx:id="colTagType" text="Type" prefWidth="180" />
                                <TableColumn fx:id="colTagAddress" text="Modbus Address" prefWidth="140" />
                                <TableColumn fx:id="colTagAction" text="Action" prefWidth="100" />
                            </columns>
                        </TableView>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="💾 Save to warehouse_tags.json" onAction="#handleSaveTags"
                                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 18; -fx-cursor: hand;" />
                            <Button text="↺ Reset to Defaults" onAction="#handleResetTags"
                                    style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 999px; -fx-background-radius: 999px; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 7 14; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <!-- Add Tag Form Card -->
                    <VBox spacing="14"
                          style="-fx-background-color: #ffffff; -fx-padding: 24px; -fx-background-radius: 16px; -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-min-width: 320px; -fx-max-width: 340px;">
                        <Label text="Add Hardware Tag" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #111827;" />
                        <Label text="Add new conveyor or sensor without writing code." style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />

                        <VBox spacing="6">
                            <Label text="Tag Name:" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                            <TextField fx:id="txtNewTagName" promptText="e.g. Diverter Arm 1"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8 12; -fx-font-size: 12px;" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Modbus Register Address:" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                            <TextField fx:id="txtNewTagAddress" promptText="e.g. 3"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8 12; -fx-font-size: 12px;" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Tag Type:" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                            <ComboBox fx:id="cmbNewTagType" maxWidth="Infinity"
                                      style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 12px;" />
                        </VBox>

                        <Button text="+ Add Tag to Profile" onAction="#handleAddTag" maxWidth="Infinity"
                                style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 18; -fx-cursor: hand;">
                            <VBox.margin>
                                <Insets top="8" />
                            </VBox.margin>
                        </Button>
                    </VBox>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>

