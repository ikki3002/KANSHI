<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.GridPane?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.kanshiwarehousemanagementsystem.controller.MainAppController"
            styleClass="main-container"
            prefWidth="1200" prefHeight="780">

    <!-- Top Navigation & Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="station-header-bar">
            <!-- Sidebar Toggle Button -->
            <Button fx:id="btnToggleSidebar" text="☰" onAction="#handleToggleSidebar" styleClass="sidebar-toggle-btn" />

            <!-- Brand -->
            <VBox spacing="2">
                <Label text="KANSHI WMS" styleClass="portal-brand" style="-fx-font-size: 22px;" />
                <Label text="Convergence IT/OT Control Platform" styleClass="station-subtitle" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Real-Time Live Clock -->
            <Label fx:id="lblClock" text="--:--:--  |  --- -- ----" styleClass="header-clock-badge" />

            <!-- Live PLC Heartbeat Indicator -->
            <HBox alignment="CENTER" spacing="8" styleClass="plc-heartbeat-pill">
                <Circle fx:id="circleHeartbeat" radius="5" fill="#ef4444" stroke="#b91c1c" strokeWidth="1" />
                <Label fx:id="lblHeartbeatStatus" text="● OFFLINE: 502" styleClass="field-label" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Operator Session & Logout -->
            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="lblOperatorEmail" text="👤 Operator: admin@gmail.com" styleClass="field-label" />
                <Button text="Logout" onAction="#handleLogout" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 14;" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Rail (3-Level Architecture Navigation) -->
    <left>
        <VBox fx:id="navRail" styleClass="nav-rail">
            <Label fx:id="lblNavCatCore" text="CORE COMMAND" styleClass="nav-category-header" />
            <Button fx:id="btnNavDashboard" text="📊 Overview Dashboard" onAction="#handleNavDashboard" styleClass="nav-item-btn, active" />

            <Label fx:id="lblNavCatWorkspaces" text="WORKSPACES" styleClass="nav-category-header">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
            </Label>
            <Button fx:id="btnNavScada" text="🏭 OT SCADA Station" onAction="#handleNavScada" styleClass="nav-item-btn" />
            <Button fx:id="btnNavInventory" text="📦 Inventory Ledger" onAction="#handleNavInventory" styleClass="nav-item-btn" />
            <Button fx:id="btnNavFinance" text="💰 Finance &amp; Invoicing" onAction="#handleNavFinance" styleClass="nav-item-btn" />

            <Label fx:id="lblNavCatSystem" text="SYSTEM &amp; CONFIG" styleClass="nav-category-header">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
            </Label>
            <Button fx:id="btnNavTags" text="⚙️ Hardware Tag Profiler" onAction="#handleNavTags" styleClass="nav-item-btn" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- System Info Footer -->
            <VBox fx:id="navRailFooter" spacing="4" style="-fx-padding: 10px; -fx-background-color: #f8fafc; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                <Label text="KANSHI WMS v1.0" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7a0c1e;" />
                <Label text="Modbus TCP / Factory I/O" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                <Label text="SQLite kanshi.db Connected" style="-fx-font-size: 10px; -fx-text-fill: #15803d; -fx-font-weight: 600;" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Workspace Host (Switches dynamically between views) -->
    <center>
        <StackPane fx:id="mainContentPane" styleClass="content-pane">

            <!-- ============================================================= -->
            <!-- VIEW 1: LEVEL 1 EXECUTIVE COMMAND OVERVIEW DASHBOARD          -->
            <!-- ============================================================= -->
            <ScrollPane fx:id="paneDashboard" fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 24px;">

                    <!-- Welcome & Executive Status Banner -->
                    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #ffffff; -fx-padding: 18px 24px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Executive Command Center (Level 1)" styleClass="station-title" style="-fx-font-size: 18px;" />
                                <Label text="LIVE SYSTEM" styleClass="badge-live-system" />
                            </HBox>
                            <Label text="Real-time operational summary uniting IT warehouse inventory and Factory I/O SCADA hardware automation." styleClass="station-subtitle" />
                        </VBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Button text="⚡ 2s Test Sequence" onAction="#handleRunAutoSequence" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                            <Button text="🛑 Quick E-Stop" onAction="#handleEmergencyStop" styleClass="btn-estop" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                            <Button text="↺ Refresh All" onAction="#handleRefreshDashboard" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                        </HBox>
                    </HBox>

                    <!-- Top KPI Metrics Grid (4 Enterprise Cards) -->
                    <HBox spacing="16">
                        <!-- KPI 1: Warehouse Valuation -->
                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="💰" style="-fx-font-size: 13px;" />
                                <Label text="TOTAL ASSET VALUATION" styleClass="field-label" style="-fx-font-size: 11px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="SQLITE LEDGER" styleClass="kpi-mini-badge-blue" />
                            </HBox>
                            <Label fx:id="lblKpiValuation" text="-- EUR" styleClass="portal-brand" style="-fx-font-size: 26px;" />
                            <Label text="Σ (Quantity × Unit Price) asset worth" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <!-- KPI 2: Total Inventory -->
                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="📦" style="-fx-font-size: 13px;" />
                                <Label text="TOTAL INVENTORY STOCK" styleClass="field-label" style="-fx-font-size: 11px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblKpiSkuCount" text="5 Active SKUs" styleClass="kpi-mini-badge-blue" />
                            </HBox>
                            <Label fx:id="lblKpiInventory" text="-- Units" styleClass="portal-brand" style="-fx-font-size: 26px;" />
                            <Label text="Across all active warehouse bin locations" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <!-- KPI 3: Line Telemetry -->
                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="🏭" style="-fx-font-size: 13px;" />
                                <Label text="CONVEYOR LINE STATUS" styleClass="field-label" style="-fx-font-size: 11px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblKpiActiveEqCount" text="0 Active" styleClass="kpi-mini-badge-gray" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Circle fx:id="circleKpiLineDot" radius="6" fill="#94a3b8" />
                                <Label fx:id="lblKpiLineState" text="IDLE" styleClass="portal-brand" style="-fx-font-size: 24px; -fx-text-fill: #64748b;" />
                            </HBox>
                            <Label text="Modbus TCP / Factory I/O telemetry" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <!-- KPI 4: Packages Processed -->
                        <VBox spacing="8" styleClass="portal-card" style="-fx-padding: 18px; -fx-min-width: 220px;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="📥" style="-fx-font-size: 13px;" />
                                <Label text="PACKAGES DETECTED" styleClass="field-label" style="-fx-font-size: 11px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblKpiLowStockBadge" text="Stock Normal" styleClass="kpi-mini-badge-green" />
                            </HBox>
                            <Label fx:id="lblKpiPackageCount" text="0 Pcs" styleClass="portal-brand" style="-fx-font-size: 26px; -fx-text-fill: #15803d;" />
                            <Label text="Auto-increments SQLite inventory on trigger" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>
                    </HBox>

                    <!-- Producer-Consumer Concurrency Telemetry Card -->
                    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #ffffff; -fx-padding: 14px 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <VBox spacing="3" prefWidth="300">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="⚡ Thread-Safe Intake Queue" styleClass="station-title" style="-fx-font-size: 15px;" />
                                <Label text="PRODUCER-CONSUMER" styleClass="kpi-mini-badge-blue" />
                            </HBox>
                            <Label text="Bounded WarehouseBuffer (ReentrantLock &amp; Conditions)" styleClass="station-subtitle" style="-fx-font-size: 11px;" />
                        </VBox>

                        <Separator orientation="VERTICAL" />

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label fx:id="lblBufferUsage" text="Queue Capacity: 0 / 10 Packages (0% Full)" styleClass="field-label" style="-fx-font-size: 12px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblProducerStatus" text="PRODUCER: IDLE" styleClass="badge-live-system" style="-fx-font-size: 10px;" />
                                <Label fx:id="lblConsumerStatus" text="CONSUMER: LISTENING" styleClass="badge-live-system" style="-fx-background-color: #dbeafe; -fx-text-fill: #1d4ed8; -fx-font-size: 10px;" />
                            </HBox>
                            <HBox fx:id="boxBufferVisualSlots" spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 2 0;" />
                        </VBox>

                        <Button text="📦 Ingest Batch (+5)" onAction="#handleTriggerProducerBatch" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                    </HBox>

                    <!-- Module Quick-Navigation Gateways (Full 4-Card Hub) -->
                    <Label text="Operational Workspaces (Level 2 Quick Access)" styleClass="station-title" style="-fx-font-size: 15px;" />
                    <HBox spacing="16">
                        <!-- Gateway 1: SCADA -->
                        <VBox spacing="8" styleClass="portal-card, gateway-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavScada">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="🏭" style="-fx-font-size: 18px;" />
                                <Label text="OT SCADA Line Control" styleClass="station-title" style="-fx-font-size: 15px;" />
                            </HBox>
                            <Label text="Interactive factory floor layout, live conveyor actuation, optical sensors, and emergency stop." wrapText="true" styleClass="station-subtitle" VBox.vgrow="ALWAYS" />
                            <Button text="Launch SCADA Station →" onAction="#handleNavScada" styleClass="btn-primary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                        </VBox>

                        <!-- Gateway 2: Inventory -->
                        <VBox spacing="8" styleClass="portal-card, gateway-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavInventory">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="📦" style="-fx-font-size: 18px;" />
                                <Label text="Inventory Stock Ledger" styleClass="station-title" style="-fx-font-size: 15px;" />
                            </HBox>
                            <Label text="Manage SQLite product catalog, SKU tracking, bin locations, and automated stock replenishment." wrapText="true" styleClass="station-subtitle" VBox.vgrow="ALWAYS" />
                            <Button text="Open Inventory Ledger →" onAction="#handleNavInventory" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                        </VBox>

                        <!-- Gateway 3: Finance -->
                        <VBox spacing="8" styleClass="portal-card, gateway-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavFinance">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="💰" style="-fx-font-size: 18px;" />
                                <Label text="Financial Valuation" styleClass="station-title" style="-fx-font-size: 15px;" />
                            </HBox>
                            <Label text="Stock valuation calculators, customer order billing, tax calculations, and financial invoice exports." wrapText="true" styleClass="station-subtitle" VBox.vgrow="ALWAYS" />
                            <Button text="View Finances →" onAction="#handleNavFinance" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                        </VBox>

                        <!-- Gateway 4: Hardware Tag Profiler -->
                        <VBox spacing="8" styleClass="portal-card, gateway-card" style="-fx-padding: 20px; -fx-cursor: hand;" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavTags">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="⚙️" style="-fx-font-size: 18px;" />
                                <Label text="Hardware Tag Profiler" styleClass="station-title" style="-fx-font-size: 15px;" />
                            </HBox>
                            <Label text="Configure Modbus PLC coils, discrete inputs, and mapping parameters stored in warehouse_tags.json." wrapText="true" styleClass="station-subtitle" VBox.vgrow="ALWAYS" />
                            <Button text="Open Tag Profiler →" onAction="#handleNavTags" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12;" />
                        </VBox>
                    </HBox>

                    <!-- Converged Real-Time Activity Log (IT & OT Events Stream) -->
                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="2">
                                <Label text="Converged Operational Activity Log (IT &amp; OT Stream)" styleClass="station-title" style="-fx-font-size: 15px;" />
                                <Label text="Live unified audit trail combining user actions, SQLite database updates, and Factory I/O PLC events." styleClass="station-subtitle" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />

                            <!-- Filter Toolbar -->
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Button fx:id="btnFilterAll" text="All Events" onAction="#handleFilterAuditAll" styleClass="filter-chip-active" />
                                <Button fx:id="btnFilterOt" text="🏭 OT Only" onAction="#handleFilterAuditOt" styleClass="filter-chip" />
                                <Button fx:id="btnFilterIt" text="📦 IT Only" onAction="#handleFilterAuditIt" styleClass="filter-chip" />
                                <Button fx:id="btnFilterSys" text="⚙️ System" onAction="#handleFilterAuditSys" styleClass="filter-chip" />
                            </HBox>

                            <Separator orientation="VERTICAL" />
                            <Button text="Clear Log" onAction="#handleClearAuditStream" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;" />
                        </HBox>
                        <TextArea fx:id="txtAuditStream" prefRowCount="7" editable="false" styleClass="telemetry-log" />
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ============================================================= -->
            <!-- VIEW 2: LEVEL 2A OT SCADA HARDWARE CONTROL STATION            -->
            <!-- ============================================================= -->
            <VBox fx:id="paneScada" visible="false" managed="false">
                <!-- Hardware Toolbar & Quick Emergency Controls -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="connection-toolbar">
                    <Label text="Host IP:" styleClass="field-label" />
                    <TextField fx:id="txtHost" text="127.0.0.1" prefWidth="125" styleClass="industrial-input" />

                    <Label text="Port:" styleClass="field-label" />
                    <TextField fx:id="txtPort" text="502" prefWidth="65" styleClass="industrial-input" />

                    <Button fx:id="btnConnect" text="Connect" onAction="#handleToggleConnect" styleClass="btn-primary" />

                    <HBox alignment="CENTER" spacing="6">
                        <Circle fx:id="circleStatus" radius="6" fill="#ef4444" stroke="#b91c1c" strokeWidth="1" />
                        <Label fx:id="lblConnectionStatus" text="DISCONNECTED" styleClass="field-label" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnAutoTest" text="⚡ 2s Test Sequence" onAction="#handleRunAutoSequence" styleClass="btn-secondary" />
                    <Button fx:id="btnEstop" text="🛑 EMERGENCY STOP" onAction="#handleEmergencyStop" styleClass="btn-estop" />
                </HBox>

                <!-- SCADA Content (Actuators, Sensors, Log) -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <VBox spacing="20" style="-fx-padding: 24px;">

                        <!-- 2D SCADA Studio Canvas (Design & Operational Modes) -->
                        <VBox spacing="12" styleClass="pipeline-board">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2">
                                    <Label text="🏭 2D Factory Floor SCADA Studio" styleClass="station-title" style="-fx-font-size: 16px;" />
                                    <Label fx:id="lblFloorStudioSubtitle" text="Live operational SCADA mimic. Toggle Edit Mode to place and orient machines on the factory floor grid." styleClass="station-subtitle" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnToggleDesignMode" text="✏️ Edit Floor Layout" onAction="#handleToggleDesignMode" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5 14;" />
                                <Button text="↺ Reset Default" onAction="#handleResetFloorLayout" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5 12;" />
                                <Label fx:id="lblMimicLineStatus" text="LINE STATUS: IDLE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-background-color: #f1f5f9; -fx-padding: 5 12; -fx-background-radius: 4px;" />
                            </HBox>

                            <!-- Amber Studio Mode Notice Banner -->
                            <HBox fx:id="boxDesignModeBanner" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10" styleClass="design-mode-banner">
                                <Label text="⚠️ LAYOUT STUDIO ACTIVE" style="-fx-font-weight: bold; -fx-text-fill: #92400e; -fx-font-size: 11px;" />
                                <Label text="Click [+] on any empty cell to place hardware tags. Click [↻] to rotate flow direction, or [🗑] to remove equipment." style="-fx-text-fill: #78350f; -fx-font-size: 11px;" />
                            </HBox>

                            <ScrollPane fitToHeight="false" fitToWidth="false" vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-padding: 0;">
                                <GridPane fx:id="floorGridPane" styleClass="floor-grid-pane" hgap="12" vgap="12" />
                            </ScrollPane>
                        </VBox>

                        <!-- Telemetry Log -->
                        <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Modbus Telemetry &amp; Event Stream" styleClass="station-title" style="-fx-font-size: 14px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Clear Log" onAction="#handleClearLog" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;" />
                            </HBox>
                            <TextArea fx:id="txtLog" prefRowCount="6" editable="false" styleClass="telemetry-log" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 3: LEVEL 2B INVENTORY LEDGER (Module 4)                   -->
            <!-- ============================================================= -->
            <VBox fx:id="paneInventory" visible="false" managed="false" spacing="16" style="-fx-padding: 20px 24px;" VBox.vgrow="ALWAYS">
                <!-- Header & Quick Stat Bar -->
                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #ffffff; -fx-padding: 16px 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📦 Warehouse Inventory Stock Ledger (Level 2B)" styleClass="station-title" style="-fx-font-size: 17px;" />
                            <Label text="SQLITE CONNECTED" styleClass="badge-live-system" />
                        </HBox>
                        <Label text="Relational inventory ledger with SKU tracking, live category filtering, and location bin management." styleClass="station-subtitle" />
                    </VBox>
                    <HBox alignment="CENTER" spacing="14">
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="CATALOG ASSET WORTH" styleClass="field-label" style="-fx-font-size: 9px;" />
                            <Label fx:id="lblInvLedgerValuation" text="\$0.00" styleClass="portal-brand" style="-fx-font-size: 18px;" />
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="TOTAL UNITS" styleClass="field-label" style="-fx-font-size: 9px;" />
                            <Label fx:id="lblInvLedgerTotalUnits" text="0 Units" styleClass="portal-brand" style="-fx-font-size: 18px; -fx-text-fill: #15803d;" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Search, Filter & Action Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 12px 18px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="🔍" style="-fx-font-size: 14px;" />
                    <TextField fx:id="txtInventorySearch" promptText="Search by SKU, product name, or bin location..." prefWidth="300" styleClass="industrial-input" />

                    <Label text="Category:" styleClass="field-label" style="-fx-font-size: 12px;">
                        <HBox.margin>
                            <Insets left="8" />
                        </HBox.margin>
                    </Label>
                    <ComboBox fx:id="cmbCategoryFilter" prefWidth="180" styleClass="industrial-input" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button text="+ Add Product" onAction="#handleOpenAddProduct" styleClass="btn-primary" style="-fx-font-size: 12px; -fx-padding: 6 14;" />
                    <Button text="⚡ Stock Adjustment" onAction="#handleOpenStockAdjustment" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 14;" />
                    <Button text="💾 Export JSON" onAction="#handleExportInventoryJson" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 12;" />
                    <Button text="↺" onAction="#handleRefreshInventory" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 10;">
                        <tooltip>
                            <Tooltip text="Refresh Inventory from SQLite" />
                        </tooltip>
                    </Button>
                </HBox>

                <!-- TableView of Products -->
                <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tableInventory" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colInvSku" text="SKU Code" prefWidth="130" />
                            <TableColumn fx:id="colInvName" text="Product Name" prefWidth="240" />
                            <TableColumn fx:id="colInvCategory" text="Category" prefWidth="140" />
                            <TableColumn fx:id="colInvQuantity" text="Stock Qty" prefWidth="110" />
                            <TableColumn fx:id="colInvUnitPrice" text="Unit Price" prefWidth="110" />
                            <TableColumn fx:id="colInvTotalValue" text="Total Value" prefWidth="120" />
                            <TableColumn fx:id="colInvLocation" text="Bin Location" prefWidth="140" />
                            <TableColumn fx:id="colInvActions" text="Actions" prefWidth="130" />
                        </columns>
                    </TableView>

                    <!-- Table Footer Status Strip -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 4 6;">
                        <Label fx:id="lblInventoryRowCount" text="Showing 0 products" styleClass="station-subtitle" style="-fx-font-size: 11px; -fx-font-weight: 600;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Database: SQLite (kanshi.db) • Table: inventory" styleClass="station-subtitle" style="-fx-font-size: 10px;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 4: LEVEL 2C FINANCE & INVOICING (Module 6 Ready)          -->
            <!-- ============================================================= -->
            <VBox fx:id="paneFinance" visible="false" managed="false" spacing="20" style="-fx-padding: 24px;">
                <VBox spacing="6" style="-fx-background-color: #ffffff; -fx-padding: 20px 24px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="Financial Valuation &amp; Billing (Level 2C)" styleClass="station-title" style="-fx-font-size: 18px;" />
                    <Label text="Automated warehouse valuation calculations, customer order billing, and invoice ledger." styleClass="station-subtitle" />
                </VBox>
                <VBox alignment="CENTER" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 40px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                    <Label text="💰 Finance Module (Step 6 of Roadmap)" styleClass="station-title" style="-fx-font-size: 16px; -fx-text-fill: #7a0c1e;" />
                    <Label text="Module 6 will connect inventory prices to calculate live total valuation and generate customer invoices." styleClass="station-subtitle" />
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- VIEW 5: LEVEL 2D HARDWARE TAG CONFIGURATION PROFILER          -->
            <!-- ============================================================= -->
            <VBox fx:id="paneTags" visible="false" managed="false" spacing="20" style="-fx-padding: 24px;">
                <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 16px 20px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="Hardware Tag Profiler &amp; JSON Configuration (Level 2D)" styleClass="station-title" style="-fx-font-size: 18px;" />
                    <Label text="Dynamically configure Modbus PLC coils and discrete inputs stored in warehouse_tags.json without code recompilation." styleClass="station-subtitle" />
                </VBox>

                <HBox spacing="24" VBox.vgrow="ALWAYS">
                    <!-- Table of Configured Tags -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <TableView fx:id="tableTags" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colTagName" text="Tag Name" prefWidth="240" />
                                <TableColumn fx:id="colTagType" text="Type" prefWidth="180" />
                                <TableColumn fx:id="colTagAddress" text="Modbus Address" prefWidth="140" />
                                <TableColumn fx:id="colTagAction" text="Action" prefWidth="100" />
                            </columns>
                        </TableView>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="💾 Save to warehouse_tags.json" onAction="#handleSaveTags" styleClass="btn-primary" />
                            <Button text="↺ Reset to Factory I/O Defaults" onAction="#handleResetTags" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                    <!-- Form to Add New Tag -->
                    <VBox spacing="14" styleClass="portal-card" style="-fx-min-width: 320px; -fx-max-width: 340px; -fx-padding: 24px;">
                        <Label text="Add Hardware Tag" styleClass="station-title" style="-fx-font-size: 16px;" />
                        <Label text="Add new conveyor or sensor without writing code." styleClass="station-subtitle" />

                        <VBox spacing="6">
                            <Label text="Tag Name:" styleClass="field-label" />
                            <TextField fx:id="txtNewTagName" promptText="e.g. Diverter Arm 1" styleClass="industrial-input" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Modbus Register Address:" styleClass="field-label" />
                            <TextField fx:id="txtNewTagAddress" promptText="e.g. 3" styleClass="industrial-input" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Tag Type:" styleClass="field-label" />
                            <ComboBox fx:id="cmbNewTagType" maxWidth="Infinity" styleClass="industrial-input" />
                        </VBox>

                        <Button text="+ Add Tag to Profile" onAction="#handleAddTag" styleClass="btn-primary" maxWidth="Infinity">
                            <VBox.margin>
                                <Insets top="8" />
                            </VBox.margin>
                        </Button>
                    </VBox>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
