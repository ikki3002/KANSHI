<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.kanshiwarehousemanagementsystem.controller.LoginController"
           style="-fx-background-color: #f3f4f6; -fx-font-family: 'Segoe UI', -apple-system, sans-serif;">

    <!-- Centered Donezo-Themed Modern Login Card -->
    <VBox alignment="CENTER" spacing="22"
          style="-fx-background-color: #ffffff; -fx-background-radius: 18px; -fx-border-color: #e5e7eb; -fx-border-radius: 18px; -fx-border-width: 1px; -fx-padding: 38px 36px; -fx-max-width: 440px; -fx-pref-width: 440px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 24, 0, 0, 8);">

        <!-- Header: Logo & Title -->
        <VBox alignment="CENTER" spacing="6">
            <HBox alignment="CENTER" spacing="8">
                <Label text="🌀" style="-fx-font-size: 26px;" />
                <Label text="KANSHI" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #14532d;" />
            </HBox>
            <Label text="Convergence IT/OT Control Platform" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
        </VBox>

        <!-- Mode Switcher Tabs (Pill Switcher) -->
        <HBox spacing="4" alignment="CENTER"
              style="-fx-background-color: #f3f4f6; -fx-background-radius: 999px; -fx-padding: 4px;">
            <Button fx:id="btnSignInTab" text="Sign In" onAction="#handleShowSignIn"
                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRegisterTab" text="Register" onAction="#handleShowRegister"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-background-radius: 999px; -fx-font-size: 13px; -fx-font-weight: 500; -fx-padding: 8 20; -fx-cursor: hand;"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Dynamic Feedback Banner -->
        <Label fx:id="lblStatus" wrapText="true" visible="false" managed="false" maxWidth="Infinity"
               style="-fx-padding: 10 14; -fx-background-radius: 8px; -fx-font-size: 12px; -fx-font-weight: 600;" />

        <!-- 1. Sign In Form -->
        <VBox fx:id="loginFormBox" spacing="16">
            <VBox spacing="6">
                <Label text="Username or Email" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <TextField fx:id="txtLoginIdentifier" promptText="Enter username or email"
                           style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 11 14; -fx-font-size: 13px; -fx-text-fill: #111827;" />
            </VBox>

            <VBox spacing="6">
                <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <PasswordField fx:id="txtLoginPassword" promptText="Enter password"
                               style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 11 14; -fx-font-size: 13px; -fx-text-fill: #111827;" />
            </VBox>

            <Button fx:id="btnLoginSubmit" text="Sign In →" onAction="#handleLoginSubmit"
                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-cursor: hand;"
                    maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="4" />
                </VBox.margin>
            </Button>
        </VBox>

        <!-- 2. Registration Form -->
        <VBox fx:id="registerFormBox" spacing="14" visible="false" managed="false">
            <VBox spacing="6">
                <Label text="Gmail / Email Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <TextField fx:id="txtRegEmail" promptText="e.g. user@gmail.com"
                           style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #111827;" />
            </VBox>

            <VBox spacing="6">
                <Label text="Username" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <TextField fx:id="txtRegUsername" promptText="Choose a username"
                           style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #111827;" />
            </VBox>

            <VBox spacing="6">
                <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <PasswordField fx:id="txtRegPassword" promptText="Create a password"
                               style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #111827;" />
            </VBox>

            <!-- Real-Time Password Strength Meter -->
            <VBox spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Strength:" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" />
                    <Label fx:id="lblStrengthLevel" text="Empty" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
                </HBox>
                <ProgressBar fx:id="progressStrength" progress="0.0" maxWidth="Infinity"
                             style="-fx-accent: #14532d; -fx-pref-height: 6px;" />
                <Label fx:id="lblStrengthHint" text="Requires >= 8 chars, uppercase, number, symbol" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" wrapText="true" />
            </VBox>

            <VBox spacing="6">
                <Label text="Confirm Password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #374151;" />
                <PasswordField fx:id="txtRegConfirmPassword" promptText="Confirm password"
                               style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 10 14; -fx-font-size: 13px; -fx-text-fill: #111827;" />
            </VBox>

            <Button fx:id="btnRegSubmit" text="Create Account →" onAction="#handleRegisterSubmit"
                    style="-fx-background-color: #14532d; -fx-text-fill: #ffffff; -fx-background-radius: 999px; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-cursor: hand;"
                    maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="4" />
                </VBox.margin>
            </Button>
        </VBox>

    </VBox>
</StackPane>
